# =========================
# RentEase Backend - Local Development
# Copy/paste into backend/.env
# =========================

NODE_ENV=development
PORT=4000

# JWT
JWT_SECRET=local_dev_secret_change_me

# Database (SQLite local)
DATABASE_DIALECT=sqlite
DATABASE_STORAGE=./database.sqlite
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=rentease
DATABASE_USER=root
DATABASE_PASSWORD=

# Frontend local URL
APP_BASE_URL=http://localhost:4200

# PowerTranz Subscription (local placeholders)
POWERTRANZ_SUBSCRIPTION_URL_TEMPLATE=https://YOUR_POWERTRANZ_SANDBOX_CHECKOUT_URL?reference={{reference}}&email={{email}}&name={{name}}&success={{successUrl}}&cancel={{cancelUrl}}
POWERTRANZ_MERCHANT_PORTAL_URL=https://merchant.powertranz.com
POWERTRANZ_CALLBACK_SECRET=local_callback_secret
POWERTRANZ_CALLBACK_HMAC_SECRET=local_hmac_secret

# Stripe (not used for subscriptions now; keep blank unless needed elsewhere)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LANDLORD_PRICE_ID=

# Optional email reminders
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@rentease.local

# Optional Twilio reminders
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
